<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:theme="@style/PreviewTheme"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="‹  Velocity"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center"
            android:text="▣"
            android:textColor="@color/lime"
            android:textSize="36sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Verify Your Mail"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/phoneInfoHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="We've sent a 4-digit verification code to your phone. Please enter it below."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/otp1"
                android:layout_width="48dp"
                android:layout_height="52dp"
                android:layout_margin="5dp"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_input"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/otp2"
                android:layout_width="48dp"
                android:layout_height="52dp"
                android:layout_margin="5dp"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_input"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/otp3"
                android:layout_width="48dp"
                android:layout_height="52dp"
                android:layout_margin="5dp"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_input"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/otp4"
                android:layout_width="48dp"
                android:layout_height="52dp"
                android:layout_margin="5dp"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_input"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/otp5"
                android:layout_width="48dp"
                android:layout_height="52dp"
                android:layout_margin="5dp"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_input"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/otp6"
                android:layout_width="48dp"
                android:layout_height="52dp"
                android:layout_margin="5dp"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_input"
                android:textSize="18sp" />

        </LinearLayout>

        <Button
            android:id="@+id/verifyButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:text="Verify  ✓"
            android:textColor="@color/dark_bg"
            android:textStyle="bold"
            android:background="@drawable/bg_button" />

        <TextView
            android:id="@+id/resendButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Didn't receive the code?\nResend Code   00:59"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="100dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="◈\nEND-TO-END ENCRYPTED"
            android:textColor="@color/text_secondary"
            android:textSize="9sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
